#!/bin/bash

# Claude
alias c="claude"

# Devbox
alias db="mosh devbox"

# Happenstance
alias hd="cd ~/happenstance/happenstance; assume hpn-dev; source .venv/bin/activate; HPN_ENV=dev-ishan OVERMIND_IGNORED_PROCESSES=public_api,uploads_manager,otelcol,chunks_manager overmind start"
alias hw="cd ~/happenstance/happenstance-web; assume hpn-web-staging && open http://localhost:3000 && bun dev --port 3000"
alias hdash="cd ~/happenstance/happenstance-dashboard; assume hpn-dev && open http://localhost:3001 && bun dev --port 3001"
alias hsql="cd ~/happenstance/happenstance; uv run util/ask_sql.py"
alias hcli="cd ~/happenstance/happenstance; assume hpn-dev; source .venv/bin/activate; bash util/hpn-pgcli"
alias ip="uv run ~/happenstance/happenstance/inspect_pickle.py"

# rsrch
alias rsrch="cd ~/Documents/code/websites/rsrch.space/scripts; uv run --python .venv/bin/python main.py"

# Quality of life
alias ls="ls -1 -haFG --color"
alias fc="expr \$(ls -1 | wc -l) - 2"
alias cat="bat"
alias activate="source .venv/bin/activate"
alias backupmac="rsync -avz --info=progress2 --stats --exclude .git/ --exclude venv/ --exclude .next/ --exclude __pycache__/ --exclude node_modules/ ~/Documents/ ~/happenstance  $DEVBOX_IP:~/documents/mac-backup"
alias weather="curl wttr.in"

# Easier navigation: .., ..., ...., .....
alias ..="cd .."
alias ...="cd ../.."
alias ....="cd ../../.."

# Brew
alias brew="HOMEBREW_NO_AUTO_UPDATE=1 brew"

# Git shortcuts
alias g="git"
alias gs="git status"
alias ga="git add ."
alias gd="git diff"
alias gc="git commit -m"
alias gb="git branch"
alias gk="git checkout"
alias gks="git checkout staging"
alias gkm="git checkout main"
alias gm="git merge"
alias gl="git log --oneline --decorate --graph"
alias ghr="git reset --hard HEAD"
alias gsh="git push"
alias gll="git pull"
alias gf="git fetch"
alias grp="git rev-parse --short HEAD | tr -d '\n'"

# Open applications
alias sublime="open -a 'sublime text'"

# Python
alias p="python3.10"
alias python="python3.10"
alias python3="python3.10"
alias pythno="python3.10"
# Run isort + format on current dir
alias ruffd="ruff check --fix --select I; ruff format"

# Node
alias brd="bun run dev"
alias nrd="bun run dev"
alias rnd="bun run dev"
alias brb="bun run build"
alias brs="bun run start"

# Tailscale
alias tailscale="/Applications/Tailscale.app/Contents/MacOS/Tailscale"

# Assume (for Granted, better AWS CLI)
alias assume=". assume"
