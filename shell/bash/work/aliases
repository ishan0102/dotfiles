# shellcheck shell=bash

# Opt-in aliases for a work Mac.

# Devbox
alias db="mosh devbox"

# Happenstance
alias hd="cd ~/happenstance/happenstance; assume hpn-dev; source .venv/bin/activate; HPN_ENV=dev-ishan OVERMIND_IGNORED_PROCESSES=public_api,uploads_manager,otelcol,chunks_manager overmind start"
alias hw="cd ~/happenstance/happenstance-web; assume hpn-web-staging && bun dev --port 3000"
alias hdash="cd ~/happenstance/happenstance-dashboard; assume hpn-dev && bun dev --port 3001"
alias hsql="cd ~/happenstance/happenstance; uv run util/ask_sql.py"
alias hcli="cd ~/happenstance/happenstance; assume hpn-dev; source .venv/bin/activate; bash util/hpn-pgcli"
alias ha="hpn-agent"
alias ip="uv run ~/happenstance/happenstance/inspect_pickle.py"
alias tigh="tig --remotes='*staging*' --remotes='*main*' --remotes='*ishan*' --branches='*staging*' --branches='*main*' --branches='*ishan*'"

# Assume (for Granted, better AWS CLI)
alias assume=". assume"
