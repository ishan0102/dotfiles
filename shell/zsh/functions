# Interactive helpers shared by macOS and remote zsh sessions.

# List the new directory after any successful directory change without
# overriding zsh's cd builtin.
autoload -Uz add-zsh-hook
dotfiles_list_directory() {
  ls
}
add-zsh-hook chpwd dotfiles_list_directory

catpdf() {
  emulate -L zsh

  if (( $# != 1 )) || [[ "$1" != *.pdf ]] || [[ ! -f "$1" ]]; then
    print -u2 'Usage: catpdf <file.pdf>'
    return 2
  fi

  if (( ! $+commands[pdftotext] )); then
    print -u2 'catpdf: pdftotext is not installed'
    return 127
  fi

  pdftotext "${1:A}" -
}

filecount() {
  emulate -L zsh
  setopt NULL_GLOB
  local -a entries
  entries=(*(DN))
  print -r -- "${#entries}"
}

mkvenv() {
  emulate -L zsh

  local target="${1:-.venv}"
  if [[ -e "$target" ]]; then
    print -u2 "mkvenv: target already exists: $target"
    return 1
  fi

  python3 -m venv "$target" || return
  source "$target/bin/activate"
  python -m pip install --upgrade pip
}

pyprof() {
  emulate -L zsh
  setopt LOCAL_TRAPS

  if (( $# == 0 )); then
    print -u2 'Usage: pyprof <python-script-or-module> [arguments...]'
    return 2
  fi

  local dependency
  for dependency in python3 gprof2dot dot; do
    if (( ! $+commands[$dependency] )); then
      print -u2 "pyprof: required command is not installed: $dependency"
      return 127
    fi
  done

  local temp_dir
  temp_dir="$(mktemp -d "${TMPDIR:-/tmp}/pyprof.XXXXXX")" || return
  trap 'command rm -rf -- "$temp_dir"' EXIT INT TERM

  local profile="$temp_dir/profile.pstats"
  local graph="$temp_dir/profile.dot"
  local output="${PWD:A}/pyprof-$(date +%Y%m%d-%H%M%S)-$$.pdf"

  python3 -m cProfile -o "$profile" "$@" || return
  gprof2dot -f pstats "$profile" -o "$graph" || return
  dot -Tpdf "$graph" -o "$output" || return
  print -r -- "Profile written to $output"

  if (( $+commands[open] )); then
    open "$output"
  elif (( $+commands[xdg-open] )); then
    xdg-open "$output"
  fi
}

rnth() {
  emulate -L zsh
  setopt NULL_GLOB

  local index="${1:-0}"
  if [[ "$index" != <0-> ]]; then
    print -u2 'Usage: rnth [zero-based-index-from-end]'
    return 2
  fi

  local -a entries
  entries=(*(DN))
  if (( index >= ${#entries} )); then
    print -u2 "rnth: index out of range: $index"
    return 1
  fi

  local position=$(( ${#entries} - index ))
  print -r -- "${entries[$position]}"
}

cdnth() {
  emulate -L zsh

  local target
  target="$(rnth "${1:-0}")" || return
  if [[ ! -d "$target" ]]; then
    print -u2 "cdnth: selected entry is not a directory: $target"
    return 1
  fi
  builtin cd -- "$target"
}

rsrch() {
  emulate -L zsh

  local project_dir="$HOME/Documents/code/websites/rsrch.space/scripts"
  if [[ ! -d "$project_dir" ]]; then
    print -u2 "rsrch: directory not found: $project_dir"
    return 1
  fi

  builtin cd "$project_dir" || return
  uv run --python .venv/bin/python main.py "$@"
}

backupmac() {
  emulate -L zsh

  if [[ -z "${DEVBOX_IP:-}" ]]; then
    print -u2 'backupmac: DEVBOX_IP is not configured'
    return 1
  fi

  rsync \
    -avz \
    --info=progress2 \
    --stats \
    --exclude=.git/ \
    --exclude=venv/ \
    --exclude=.venv/ \
    --exclude=.next/ \
    --exclude=__pycache__/ \
    --exclude=node_modules/ \
    "$HOME/Documents/" \
    "$HOME/happenstance" \
    "$DEVBOX_IP:~/documents/mac-backup"
}
