{
  "editor.inlineSuggest.enabled": true,
  "workbench.editorAssociations": {
    "*.pdf": "latex-workshop-pdf-hook",
  },
  "code-runner.runInTerminal": true,
  "[latex]": {
    "editor.wordWrap": "on",
  },
  "git.confirmSync": false,
  "git.enableSmartCommit": true,
  "explorer.confirmDragAndDrop": false,
  "editor.tokenColorCustomizations": {
    "textMateRules": [
      {
        "scope": "rainbow1",
        "settings": {
          "foreground": "#14b8a6",
        },
      },
      {
        "scope": "keyword.rainbow2",
        "settings": {
          "foreground": "#06b6d4",
          "fontStyle": "bold",
        },
      },
      {
        "scope": "entity.name.function.rainbow3",
        "settings": {
          "foreground": "#0ea5e9",
          "fontStyle": "italic",
        },
      },
      {
        "scope": "comment.rainbow4",
        "settings": {
          "foreground": "#3b82f6",
          "fontStyle": "underline",
        },
      },
      {
        "scope": "string.rainbow5",
        "settings": {
          "foreground": "#6366f1",
        },
      },
      {
        "scope": "variable.parameter.rainbow6",
        "settings": {
          "foreground": "#8b5cf6",
          "fontStyle": "bold",
        },
      },
      {
        "scope": "constant.numeric.rainbow7",
        "settings": {
          "foreground": "#a855f7",
          "fontStyle": "italic",
        },
      },
      {
        "scope": "entity.name.type.rainbow8",
        "settings": {
          "foreground": "#d946ef",
          "fontStyle": "underline",
        },
      },
      {
        "scope": "markup.bold.rainbow9",
        "settings": {
          "foreground": "#ec4899",
        },
      },
      {
        "scope": "invalid.rainbow10",
        "settings": {
          "foreground": "#f43f5e",
        },
      },
    ],
  },
  "editor.unicodeHighlight.ambiguousCharacters": false,
  "notebook.output.textLineLimit": 50,
  "editor.unicodeHighlight.invisibleCharacters": false,
  "python.languageServer": "None",
  "javascript.updateImportsOnFileMove.enabled": "always",
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": "active",
  "editor.stickyScroll.enabled": true,
  "editor.parameterHints.enabled": false,
  "editor.suggest.showTypeParameters": false,
  "editor.inlayHints.enabled": "off",
  "[python]": {
    "editor.formatOnType": true,
  },
  "[javascript][javascriptreact][typescript][typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "workbench.iconTheme": "material-icon-theme",
  "extensions.ignoreRecommendations": true,
  "redhat.telemetry.enabled": false,
  "git.openRepositoryInParentFolders": "always",
  "terminal.integrated.fontFamily": "monospace",
  "editor.minimap.enabled": false,
  "window.newWindowDimensions": "inherit",
  "editor.lightbulb.enabled": "off",
  "python.createEnvironment.trigger": "off",
  "cursor.cpp.disabledLanguages": ["scminput"],
  "git.autofetch": true,
  "git.enableCommitSigning": true,
  "workbench.layoutControl.enabled": false,
  "editor.renderWhitespace": "none",
  "diffEditor.ignoreTrimWhitespace": true,
  "typescript.updateImportsOnFileMove.enabled": "always",
  "search.quickOpen.history.filterSortOrder": "recency",
  "css.lint.unknownAtRules": "ignore",
  "workbench.colorTheme": "One Dark+ (Sublime)",
  "editor.accessibilitySupport": "on",
  "cursorpyright.shouldImportPylanceSettings": "never",
  "cursor.enable_agent_window_setting": true,
  "[dockercompose]": {
    "editor.insertSpaces": true,
    "editor.tabSize": 2,
    "editor.autoIndent": "advanced",
    "editor.defaultFormatter": "redhat.vscode-yaml",
  },
  "[github-actions-workflow]": {
    "editor.defaultFormatter": "redhat.vscode-yaml",
  },
  "window.autoDetectColorScheme": true,
  "workbench.preferredLightColorTheme": "Cursor Light",
  "claudeCode.preferredLocation": "panel",
  "json.schemaDownload.enable": true,
  "cursor.composer.usageSummaryDisplay": "always",
  "accessibility.signalOptions.volume": 0,
  "window.nativeTabs": true,
  "workbench.preferredDarkColorTheme": "Cursor Dark Midnight",
}
